// Übernommen aus WM-Tipp infra/cron-worker/wrangler.jsonc, angepasst: Cron */10, APP_URL.
// Cloudflare-Worker "flutlicht-cron": Taktgeber für /api/cron/tick (KONZEPT 9).
// Deploy:  npx wrangler deploy            (aus diesem Verzeichnis)
// Secret:  npx wrangler secret put CRON_SECRET
{
  "name": "flutlicht-cron",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  // Reiner Cron-Worker: keine öffentliche URL nötig (und keine angreifbare).
  "workers_dev": false,
  "triggers": {
    // Alle 10 Minuten (UTC, exakt).
    "crons": ["*/10 * * * *"],
  },
  "vars": {
    // Beim Go-live (M11) auf die echte Domain setzen.
    "APP_URL": "https://flutlicht.a-tec.dev",
  },
  "observability": { "enabled": true },
}
